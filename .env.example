# Copy to .env for local `netlify dev` testing. NEVER commit the real .env file.
# In production, set these as environment variables in the Netlify site dashboard
# (Site configuration -> Environment variables) — never in client-side code or the repo.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

